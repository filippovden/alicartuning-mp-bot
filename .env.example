# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=123456789,987654321

# Backend API (FastAPI, /newProduct, /publish/{id} и т.д.) — общий секрет,
# передаётся клиентом в заголовке X-API-Key. Сгенерируйте случайную строку
# (например `openssl rand -hex 32`). Пусто = API отклоняет ВСЕ запросы
# (fail-closed). Порт 8000 в docker-compose.yml по умолчанию НЕ публикуется на
# хост (бот работает через БД напрямую и backend ему не нужен) — но задайте
# токен всё равно, на случай если порт когда-нибудь откроете.
API_AUTH_TOKEN=

# База данных. Порт postgres не публикуется на хост (см. docker-compose.yml),
# так что менять пароль по умолчанию не обязательно — он не достижим извне.
# Если всё же меняете POSTGRES_PASSWORD ниже — обновите пароль и здесь, в
# DATABASE_URL/DATABASE_URL_SYNC, значения должны совпадать.
POSTGRES_USER=alicartuning
POSTGRES_PASSWORD=alicartuning
POSTGRES_DB=alicartuning
DATABASE_URL=postgresql+asyncpg://alicartuning:alicartuning@postgres:5432/alicartuning
DATABASE_URL_SYNC=postgresql+psycopg2://alicartuning:alicartuning@postgres:5432/alicartuning

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Несколько магазинов (до 4 WB + до 4 Ozon) — раздел 1 ТЗ v5. Пусто = один
# магазин на площадку из одиночных полей WB_API_KEY/OZON_CLIENT_ID/OZON_API_KEY
# ниже (обратная совместимость). См. DEPLOYMENT.md → «Несколько магазинов».
# SHOPS_JSON=[{"id":"wb-salon","name":"WB Салон","platform":"wb","api_key":"PUT_WB_TOKEN"},{"id":"ozon-salon","name":"Ozon Салон","platform":"ozon","client_id":"123","api_key":"PUT_OZON_TOKEN"}]
SHOPS_JSON=

# Wildberries Seller API
WB_API_KEY=
WB_API_BASE_URL=https://content-api.wildberries.ru
WB_STATS_API_BASE_URL=https://statistics-api.wildberries.ru
WB_FEEDBACKS_API_BASE_URL=https://feedbacks-api.wildberries.ru
# Опрос nmID после создания карточки (см. ProductService._wait_for_wb_nm_id) —
# карточка создаётся асинхронно, nmID появляется не сразу. 12×3с ≈ до 36с ожидания.
WB_NM_ID_POLL_ATTEMPTS=12
WB_NM_ID_POLL_DELAY_SECONDS=3

# Ozon Seller API
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_API_BASE_URL=https://api-seller.ozon.ru
# Ставка НДС для карточек ("0", "0.05", "0.07", "0.10", "0.20") — уточните у бухгалтера
OZON_DEFAULT_VAT=0

# AI
ANTHROPIC_API_KEY=
# claude-sonnet-5 — действующий ID модели (Anthropic API, 2026), не требует даты-суффикса.
# Для более сложных/дорогих задач можно переключить на claude-opus-5.
# ⚠️ Перед продом один раз проверьте это значение живым ключом (например,
# GET https://api.anthropic.com/v1/models с вашим ANTHROPIC_API_KEY, или просто
# тестовый запрос через generate_ai_content) — доступность моделей и их точные
# ID может меняться со временем, а бот не должен узнать об этом только в проде.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=

# xAI Grok Imagine — AI-генерация инфографики карточек (получить ключ на
# https://console.x.ai). Пусто = Pillow-fallback — фото товара с диска
# (если уже загружено) + текст буллетов на фирменном фоне, бот не падает.
# Стоимость ориентировочно $0.02–0.05 за изображение (актуальные цены —
# на console.x.ai).
XAI_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image-quality

# Хранилище файлов. local — только диск контейнера, WB не сможет скачать
# фото по такому "URL" (это локальный путь, не публичный http(s) адрес) —
# нужно для разработки, но не для публикации карточек в проде.
# STORAGE_BACKEND=s3 + все 4 поля ниже — файлы дополнительно заливаются в
# S3-совместимое хранилище (AWS S3, MinIO, Selectel/Timeweb/Yandex Object
# Storage и т.п.), url в БД становится реальным публичным HTTPS-адресом.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Бренд
BRAND_NAME=ALICARTUNING

# Веб-админка (SQLAdmin, /admin) — без пароля панель не поднимается
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=
ADMIN_PANEL_SECRET_KEY=

ENVIRONMENT=development
LOG_LEVEL=INFO
